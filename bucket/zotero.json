{
    "version": "10.0.8",
    "description": "Open-source reference management software to manage bibliographic data and related research materials.",
    "homepage": "https://www.zotero.org/",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://download.zotero.org/client/release/10.0.8/Zotero-10.0.8_x64_setup.exe#/dl.7z",
            "hash": "1ba5d091fd24b50db1159c71650f55303d99c82e66494dc09eddab76a4179d73"
        },
        "32bit": {
            "url": "https://download.zotero.org/client/release/10.0.8/Zotero-10.0.8_win32_setup.exe#/dl.7z",
            "hash": "69018a0eac1f01a4e474d395af96e36da12fbd57ee82eca31327e13bc9dd8105"
        },
        "arm64": {
            "url": "https://download.zotero.org/client/release/10.0.8/Zotero-10.0.8_arm64_setup.exe#/dl.7z",
            "hash": "8ac06a4c05f995ca1b67202d3327876e9119f9e38a1ba366fcbb57a9dd87d8a5"
        }
    },
    "extract_dir": "core",
    "notes": [
        "Launch Zotero using the Scoop shortcut or the 'zotero' command to use portable storage.",
        "Existing Windows user data is not migrated automatically. With Zotero closed, copy your profile to '$persist_dir\\profile' and your Zotero data directory to '$persist_dir\\data'.",
        "Run '$dir\\install-zotero-url-protocol.ps1' to register or refresh the portable zotero:// handler."
    ],
    "pre_install": [
        "'profile', 'data', 'appdata', 'localappdata' | ForEach-Object { New-Item -ItemType Directory -Path \"$dir\\$_\" -Force | Out-Null }",
        "$scriptsDir = Join-Path $bucketsdir \"$bucket\\scripts\\zotero\"",
        "Add-Type -Path \"$scriptsDir\\zotero-portable.cs\" -OutputAssembly \"$dir\\zotero-portable.exe\" -OutputType WindowsApplication"
    ],
    "bin": [
        [
            "zotero-portable.exe",
            "zotero"
        ]
    ],
    "shortcuts": [
        [
            "zotero-portable.exe",
            "Zotero",
            "",
            "zotero.exe"
        ]
    ],
    "post_install": [
        "$scriptsDir = Join-Path $bucketsdir \"$bucket\\scripts\\zotero\"",
        "Get-ChildItem \"$scriptsDir\\*.ps1\" | ForEach-Object {",
        "    $content = Get-Content $_",
        "    $content = $content.Replace('REPLACE_HERE', $dir)",
        "    if ($global) { $content = $content.Replace('HKCU', 'HKLM') }",
        "    Set-Content \"$dir\\$($_.Name)\" $content -Encoding 'utf8' -Force",
        "}"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    Write-Host 'Unregistering the ''zotero://'' URL protocol...'",
        "    Remove-Item 'HKCU:\\SOFTWARE\\Classes\\zotero', 'HKLM:\\SOFTWARE\\Classes\\zotero' -ErrorAction 'SilentlyContinue' -Recurse -Force",
        "    Write-Host 'Done!'",
        "}"
    ],
    "persist": [
        "profile",
        "data",
        "appdata",
        "localappdata"
    ],
    "checkver": {
        "script": [
            "try { $detail = Invoke-WebRequest 'https://www.zotero.org/download/client/dl?channel=release&platform=win-x64' -MaximumRedirection 0 -ErrorAction Ignore } catch { $_.Exception.Response }",
            "return $detail.Headers.Location"
        ],
        "regex": "Zotero-([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.zotero.org/client/release/$version/Zotero-$version_x64_setup.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://download.zotero.org/client/release/$version/Zotero-$version_win32_setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://download.zotero.org/client/release/$version/Zotero-$version_arm64_setup.exe#/dl.7z"
            }
        }
    }
}
